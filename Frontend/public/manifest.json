{
  "manifest_version": 3,
  "name": "PoliTalk",
  "version": "2.0.0",
  "description": "See the political lean of short-form videos on TikTok, Instagram and YouTube, with the evidence behind it.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "PoliTalk",
    "default_icon": {
      "16": "logo-small.png",
      "48": "logo.png",
      "128": "logo.png"
    }
  },
  "icons": {
    "16": "logo-small.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.tiktok.com/*",
        "*://www.instagram.com/*",
        "*://www.youtube.com/*"
      ],
      "js": [
        "loader.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content.js",
        "assets/*",
        "logo.png"
      ],
      "matches": [
        "*://www.tiktok.com/*",
        "*://www.instagram.com/*",
        "*://www.youtube.com/*"
      ]
    }
  ]
}
