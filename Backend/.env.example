# Required
GEMINI_API_KEY=your_gemini_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Optional
# PORT=3000
# GEMINI_MODEL=gemini-2.5-flash
# ELEVENLABS_MODEL=scribe_v2
# Shared secret the extension must send (set it in the extension's settings). Recommended for any deployed backend.
# POLITALK_API_KEY=
# Comma-separated extension origins allowed to call the API, e.g. chrome-extension://<your-extension-id>
# ALLOWED_ORIGINS=
# RATE_LIMIT_PER_MINUTE=20
# CACHE_TTL_HOURS=24
